# ---------------------------------------------------------------------
# Image masters: kept locally (and in Dropbox), never committed.
#   - img/originals/ holds the source TIFFs/PNGs (~7 GB).
#   - *_native.jpg are the full-resolution JPGs tools/make_sizes.py keeps
#     as its source (~700 MB; some exceed GitHub's 100 MB file limit).
# The resized *_2powNN.jpg files next to them ARE committed — the site
# serves those.
# ---------------------------------------------------------------------
img/originals/
*_native.jpg

# Huge raw/editing formats, wherever they end up
*.tif
*.tiff
*.psd
*.psb
*.fits
*.fit
*.fz

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS / editors
.DS_Store
._*
.vscode/
.idea/
*.swp
*~

# Generated by tools/build_nojs.py (text-only copy of the site); not tracked.
# Only nojs/README.md is kept, so people browsing the repo know what the folder is.
# (`nojs/` alone would ignore the whole folder and make the README impossible to re-include.)
nojs/*
!nojs/README.md

# Local preview / scratch output
*.log
.cache/
tmp/
